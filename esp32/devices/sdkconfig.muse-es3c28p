# ES3C28P / ES3N28P V1.0: ESP32-S3 (16 MB flash, 8 MB octal PSRAM),
# 2.8" 240x320 ILI9341V IPS touch LCD, ES8311 speaker and mic. Native USB
# Serial/JTAG (303a:1001), BOOT on GPIO0, backlight PWM on GPIO45.
# Load last, after sdkconfig.defaults and sdkconfig.muse.
CONFIG_IDF_TARGET="esp32s3"
CONFIG_MUSE_BOARD_ES3C28P=y
CONFIG_HOMEHUB_BUTTON_GPIO=0
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# PSRAM is required for the UI, images, voice session and tunnel.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_FETCH_INSTRUCTIONS=y
CONFIG_SPIRAM_RODATA=y
CONFIG_SPIRAM_XIP_FROM_PSRAM=y
CONFIG_SPIRAM_ALLOW_STACK_EXTERNAL_MEMORY=y
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y
CONFIG_LV_DRAW_SW_DRAW_UNIT_CNT=2
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
# Static buffers in PSRAM: Wi-Fi's, lwIP's and BT's, and those marked
# EXT_RAM_BSS_ATTR (Muse's chat turn, the tunnel batch). The chip always has
# PSRAM, so booting without it needn't be allowed.
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
# That forces Wi-Fi's TX buffers static, in internal RAM: 8, not 16, which
# voice over the tunnel doesn't fill.
CONFIG_ESP_WIFI_STATIC_TX_BUFFER_NUM=8

# The OpenSpeech gateway returns larger WebSocket upgrade response headers than
# tcp_transport's default 1 KB handshake buffer.
CONFIG_WS_BUFFER_SIZE=4096

# Speak replies with Doubao Seed-TTS 2.0. The Ark key is a secret and is NOT
# set here: put CONFIG_MUSE_DOUBAO_TTS_TOKEN="ark-..." in a local, un-tracked
# overlay appended after this one (e.g. devices/sdkconfig.muse-es3c28p.local).
CONFIG_MUSE_DOUBAO_TTS=y
